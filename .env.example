# Skopirujte do .env a vyplnte. Subor .env nikdy necommitujte.
DOMAIN=ucto.example.sk
DATABASE_PASSWORD=zmente-na-dlhe-nahodne-heslo

# Prihlasenie Google uctom (odporucane)
SPRING_PROFILES_ACTIVE=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ciarkou oddeleny zoznam e-mailov alebo domen s pristupom
APP_ALLOWED_EMAILS=pokladnik@example.sk,predseda@example.sk
APP_ALLOWED_DOMAINS=

# Alternativa na skusanie: SPRING_PROFILES_ACTIVE= (prazdne) a lokalne heslo (min. 12 znakov)
APP_LOCAL_PASSWORD=
